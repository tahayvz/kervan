<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      payment-service — ödeme bounded context'i (Faz 4).

      Saga'nın ikinci adımını yürütür: siparişin tutarını tahsil eder, sonraki bir
      adım başarısız olursa iade eder. Karar gerekçeleri: ADR-0005 (Saga), ADR-0009
      (mesaj topolojisi).

      Para ACID ister; bu yüzden PostgreSQL (ADR-0006).
    -->
    <parent>
        <groupId>com.kervan</groupId>
        <artifactId>kervan-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>payment-service</artifactId>
    <name>Payment Service</name>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!--
          Bu servisin HTTP API'si YOK; is akisi tamamen Kafka uzerinden yurur.
          Web sunucusu yalnizca GOZLEMLENEBILIRLIK icin var.

          Olmadan actuator hicbir yerde yayinlanmaz: /actuator/prometheus diye
          bir uc olusmaz, Prometheus hedefi surekli "down" gorunur ve bu servisin
          is metrikleri (stok/odeme sonuclari) uretilir ama DISARI CIKMAZ.
          Panolar bos kalir, hicbir yerde hata cikmaz.

          Bu durum Faz 10'da, sistem ilk kez butunuyle calistirildiginda goruldu.
          Faz 6'daki testler metrikleri MeterRegistry uzerinden okudugu icin
          HTTP yolunu hic denememisti.

          Is portu (server.port) hicbir sey sunmaz; actuator ayri yonetim
          portunda durur (ADR-0014).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Dayaniklilik: devre kesici, yeniden deneme, es zamanlilik siniri.
          Ayarlar application.yml'de, uygulama ise ResilientPaymentGateway'de
          ACIKCA yapilir (anotasyonla degil); gerekce ADR-0016.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
        </dependency>

        <!--
          İzleme (tracing) — bir isteğin servisler arasındaki yolculuğunun kaydı.
          Spring zaten her HTTP isteği, Kafka mesajı ve repository çağrısı için bir
          "observation" üretir; bu köprü onları OpenTelemetry span'ine çevirir.
          Java ajanı (-javaagent) yerine kod içinde bağlanmasının gerekçesi ADR-0012.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Span'leri OTLP ile toplayıcıya gönderir; adres application.yml'de. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!--
          Prometheus biçiminde metrik. Uygulama metriği DIŞARI GÖNDERMEZ;
          /actuator/prometheus ucunda yayınlar ve Prometheus gelip okur (pull).
          Gerekçe: ADR-0014.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>com.kervan</groupId>
            <artifactId>event-contracts</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.confluent</groupId>
            <artifactId>kafka-avro-serializer</artifactId>
            <version>${confluent.version}</version>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!--
                      CALISTIRILABILIR JAR AYRI BIR DOSYA OLSUN.

                      Varsayilanda `repackage` hedefi ASIL ARTIFACT'I DEGISTIRIR:
                      target/<modul>.jar artik normal bir jar degil, siniflari
                      BOOT-INF/classes/ altinda duran bir fat jar olur.

                      Bunun gorunmeyen bedeli, baska bir modulun bu module
                      BAGIMLI OLAMAMASIDIR: siniflar beklenen yerde olmadigi icin
                      derleme ya da calisma aninda bulunamaz. Uc servisi ayni
                      JVM'de ayaga kaldiran saga testi tam olarak buna takildi.

                      classifier ile iki dosya olusur:
                        <modul>.jar        -> normal jar, bagimlilik olarak kullanilir
                        <modul>-exec.jar   -> calistirilabilir olan; Dockerfile BUNU kopyalar
                    -->
                    <classifier>exec</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
