<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      saga-e2e-tests — UC SERVISIN BIRLIKTE calistigi test.

      URETIM KODU YOK. Bu modul hicbir yere dagitilmaz; yalnizca test barindirir.

      NEDEN AYRI BIR MODUL?
      Test ayni anda order, inventory ve payment siniflarina ihtiyac duyuyor.
      Bunu bir servisin icine koymak, o servisi komsularina bagimli yapardi ve
      ADR-0002'nin cizdigi modul sinirini bozardi. Bagimlilik yonu burada dogru:
      test servislere bagli, servisler birbirine degil.
    -->
    <parent>
        <groupId>com.kervan</groupId>
        <artifactId>kervan-platform</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>saga-e2e-tests</artifactId>
    <name>Saga End-to-End Tests</name>

    <properties>
        <!-- Dagitilacak bir sey yok: depoya yuklenmesin. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <!--
          Uc servis de test kapsaminda. Bunlarin normal (fat olmayan) jar'larini
          kullanabilmek icin her birinde spring-boot-maven-plugin'e
          <classifier>exec</classifier> eklendi; gerekcesi o POM'larda yazili.
        -->
        <dependency>
            <groupId>com.kervan</groupId>
            <artifactId>order-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.kervan</groupId>
            <artifactId>inventory-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.kervan</groupId>
            <artifactId>payment-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
