{
  "namespace": "com.kervan.contracts.order.v1",
  "type": "record",
  "name": "OrderPlaced",
  "doc": "Siparis olusturuldugunda yayinlanan olay. Servis sinirinin disina cikan sozlesmedir: alanlari yalnizca geriye donuk uyumlu bicimde degisebilir (bkz. SchemaEvolutionTest).",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Siparisin kimligi. Kafka mesaj anahtari olarak da kullanilir; ayni siparisin olaylari ayni partition'a duser ve sirasi korunur."
    },
    {
      "name": "customerId",
      "type": "string",
      "doc": "Siparisi veren musterinin kimligi."
    },
    {
      "name": "totalAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "Toplam tutar. double DEGIL: kayan nokta para hesabinda yuvarlama hatasi uretir. Avro decimal, degeri olceklenmis tamsayi olarak byte dizisinde tasir; okuyan taraf ayni BigDecimal'i geri elde eder. Olcek 4, veritabanindaki NUMERIC(19,4) ile ayni: 3 ondalikli para birimleri (KWD, BHD, OMR) de kayipsiz sigar. Yazan taraf degeri tam olarak bu olcege getirmelidir; Avro farkli olcekli bir degeri kabul etmez."
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 para birimi kodu (TRY, USD). Tutar bu birim olmadan anlamsizdir."
    },
    {
      "name": "items",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "OrderItem",
          "doc": "Siparisteki tek bir satir.",
          "fields": [
            {"name": "productId", "type": "string", "doc": "Katalogtaki urunun kimligi."},
            {"name": "sku", "type": "string", "doc": "Stok kodu."},
            {"name": "quantity", "type": "int", "doc": "Adet."},
            {
              "name": "unitPrice",
              "type": {
                "type": "bytes",
                "logicalType": "decimal",
                "precision": 19,
                "scale": 4
              },
              "doc": "Siparis anindaki birim fiyat. Urunun guncel fiyati sonradan degisse bile bu deger degismez."
            }
          ]
        }
      },
      "doc": "Siparis satirlari."
    },
    {
      "name": "placedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Siparisin olusturuldugu an (UTC, milisaniye). Instant nanosaniye tutar; buraya yazilirken milisaniyeye kirpilir."
    }
  ]
}
