{
  "namespace": "com.kervan.contracts.payment.v1",
  "type": "record",
  "name": "ProcessPayment",
  "doc": "KOMUT: siparisin tutarinin tahsil edilmesini ister.",
  "fields": [
    {
      "name": "orderId",
      "type": "string",
      "doc": "Saga'nin kimligi. Butun komut ve olaylar bu anahtarla yazilir; ayni siparisin adimlari ayni partition'a duser ve sirasi korunur."
    },
    {
      "name": "customerId",
      "type": "string",
      "doc": "Odemeyi yapan musteri."
    },
    {
      "name": "amount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "Tahsil edilecek tutar. Olcek 4 -- gerekcesi OrderPlaced.avsc'de."
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 kodu."
    },
    {
      "name": "requestedAt",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Komutun uretildigi an."
    }
  ]
}
