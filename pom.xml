<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Kervan — parent POM (Maven multi-module).
      Karar gerekçesi: docs/adr/0002-monorepo-maven-multimodule.md
      Bu POM kod içermez; amacı tüm servislerde bağımlılık SÜRÜMLERİNİ
      (dependencyManagement) ve derleme davranışını merkezî yönetmektir.
      Servis modülleri fazlar ilerledikçe <modules> altına eklenecek.
    -->

    <!-- Spring Boot starter parent'tan miras: sağlam varsayılan sürüm/plugin yönetimi -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.kervan</groupId>
    <artifactId>kervan-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Kervan Commerce Platform</name>
    <description>Event-driven, çok servisli e-ticaret platformu</description>

    <!--
      Servis modülleri fazlar geldikçe buraya eklenir.
      Faz 1: catalog-service (MongoDB üzerinde ilk mikroservis).
      Faz 3: order-service (PostgreSQL + Transactional Outbox → Kafka).
      Faz 3: event-contracts (servisler arası Avro olay şemaları) — ÖNCE derlenmeli,
             çünkü diğer modüller ona bağımlı.
    -->
    <modules>
        <module>event-contracts</module>
        <module>catalog-service</module>
        <module>order-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Merkezî yönetilen dış BOM/bağımlılık sürümleri -->
        <spring-cloud.version>2024.0.1</spring-cloud.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <springdoc.version>2.8.5</springdoc.version>
        <!--
          Avro sürümü Confluent'ınkiyle AYNI tutulur. Confluent 7.8.0'ın kendi
          bağımlılığı Avro 1.11.4'tür; şemadan kod üreten eklenti farklı bir sürüm
          kullanırsa üretilen sınıflar çalışma zamanındaki Avro ile uyuşmayabilir.
          Confluent sürümü yükseltilirken bu satır da birlikte güncellenmelidir.
          1.11.4 aynı zamanda CVE-2024-47561'i (şema ayrıştırmada kod çalıştırma)
          kapatan sürümdür; daha eskiye inilmemelidir.
        -->
        <avro.version>1.11.4</avro.version>
        <confluent.version>7.8.0</confluent.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <mongock.version>5.5.0</mongock.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud (Gateway, vb.) — Boot 3.4 ile uyumlu sürüm dizisi -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Testcontainers — gerçek MongoDB/Postgres/Kafka'ya karşı entegrasyon testi -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Mongock — MongoDB migration (Flyway'in NoSQL muadili) -->
            <dependency>
                <groupId>io.mongock</groupId>
                <artifactId>mongock-bom</artifactId>
                <version>${mongock.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- OpenAPI / Swagger UI (API-first) -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Resilience4j (circuit breaker/retry/bulkhead) — Faz 7 -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Spring Boot plugin: yürütülebilir jar + imaj build -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <!-- Confluent (Avro serializer + Schema Registry istemcisi) burada barınır -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent</name>
            <url>https://packages.confluent.io/maven/</url>
        </repository>
    </repositories>

</project>
