# --- Java / Maven ---
target/
*.class
*.jar
*.war
!.mvn/wrapper/maven-wrapper.jar
dependency-reduced-pom.xml

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
