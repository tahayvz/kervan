# --- OS ---
.DS_Store
Thumbs.db

# --- Logs / runtime ---
*.log
# Her seviyedeki logs/ klasoru yok sayilir (modullerde de olusuyor).
logs/
# ...ama depo kokundeki logs/ KLASORU dursun: Alloy onu baglar.
# Sira onemli: once klasor geri alinir, sonra icerigi dislanir. Tersi
# calismaz -- git, dislanmis bir klasorun icine hic bakmaz.
!/logs/
/logs/*
!/logs/README.txt
*.pid

# --- Env / secrets (asla commit'lenmez) ---
.env
.env.local
*.local.env
secrets/

# --- Docker / veri hacimleri (lokal) ---
**/data/
volumes/

# --- Test / coverage ---
.surefire/
coverage/
*.exec

# --- Kişisel çalışma çıktıları (repoya girmez) ---
# Projeyi tek dosyada toplayan yerel paketler; repo içeriğinin eski kopyalarını
# taşırlar ve yayınlanmamalıdırlar.
kervan-catalog.md
kervan-kavramlar.md
